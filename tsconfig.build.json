{
    "compilerOptions": {
        // Type Checking
        "strict": true,
        // Modules
        "module": "ESNext",
        "moduleResolution": "bundler",
        "paths": {
            "@sberbusiness/triplex-next": ["./src"],
            "@sberbusiness/triplex-next/*": ["./src/*"]
        },
        // "node" — явно: компоненты читают process.env.NODE_ENV. До vitest 4 типы
        // Node приезжали транзитивно через vitest/globals, теперь — нет.
        "types": ["node", "@testing-library/jest-dom/vitest", "vitest/globals"],
        // Emit
        "outDir": "dist",
        // Language and Environment
        "jsx": "react-jsx",
        "target": "ESNext",
        // Interop Constraints
        "allowSyntheticDefaultImports": true,
        "forceConsistentCasingInFileNames": true,
        "esModuleInterop": true,
        // Completeness
        "skipLibCheck": false
    },
    "include": ["src"]
}
